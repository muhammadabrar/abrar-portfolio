NEXT_PUBLIC_SITE_URL=https://muhammadabrar.dev

# PostgreSQL connection (Neon recommended for Vercel — works over IPv4)
# Neon: https://console.neon.tech → create project → Connection string → copy
# Paste the REAL URI below (do not leave placeholders like YOUR_REGION)
DATABASE_URL="postgresql://neondb_owner:REAL_PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional: same as DATABASE_URL for Neon (or Supabase session pooler for migrations)
DIRECT_URL="postgresql://neondb_owner:REAL_PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Platform free-tier Mistral key (required for free guests)
MISTRAL_API_KEY=

# Qdrant vector database
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
