NEXT_PUBLIC_SITE_URL=https://muhammadabrar.dev

# Neon pooled URI (Dashboard → Connection details → pooled)
# Avoid channel_binding=require with node-pg — it often breaks local/Vercel.
# Example:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://neondb_owner:REAL_PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:REAL_PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Platform free-tier Mistral key (required for free guests)
MISTRAL_API_KEY=

# Qdrant vector database
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
